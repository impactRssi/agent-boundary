# ---------------------------------------------------------------------------
# Agent Boundary -- example environment.
#
# This file is COMMITTED. Every secret the project reads is referenced here and
# valued nowhere. Copy to `.env` (gitignored) and fill in locally.
#
#   cp .env.example .env
#
# A value in this file is a bug. The secret scan in CI is blocking.
# ---------------------------------------------------------------------------

# --- Model provider -------------------------------------------------------
# Used only by the worked example (N-19) and the E2E tier. The broker itself
# never calls a model: no probabilistic component sits on the authorisation
# path (ADR-0001).
ANTHROPIC_API_KEY=

# --- Ticketing tool (worked example) --------------------------------------
# The example wires an agent to a ticketing API precisely because a ticket is
# the canonical attacker-writable carrier (threat model §2).
TICKETING_BASE_URL=
TICKETING_API_TOKEN=

# --- Confinement (I4) -----------------------------------------------------
# Filesystem root the agent's filesystem tool is confined to. Paths are
# resolved -- symlinks and `..` included -- BEFORE the confinement check.
AGENT_BOUNDARY_FS_ROOT=./workspace

# Comma-separated egress allowlist. Empty means no egress is permitted, which
# is the correct default: a task that needs the network says so.
AGENT_BOUNDARY_EGRESS_ALLOWLIST=

# --- Budget caps (I3) -----------------------------------------------------
# Per task. On reaching any cap the task fails closed and reports it.
AGENT_BOUNDARY_MAX_CALLS=25
AGENT_BOUNDARY_MAX_COST=1.00
AGENT_BOUNDARY_MAX_WALL_CLOCK_S=120

# --- Approval (I3) --------------------------------------------------------
# Where out-of-band approval records for irreversible calls are read from.
# This channel MUST NOT be reachable from the agent loop -- an approval the
# agent can write is not an approval.
AGENT_BOUNDARY_APPROVAL_STORE=./.approvals

# --- Audit (I3) -----------------------------------------------------------
# Append-only trace destination. The store exposes no mutation path.
AGENT_BOUNDARY_AUDIT_PATH=./.audit/trace.jsonl
